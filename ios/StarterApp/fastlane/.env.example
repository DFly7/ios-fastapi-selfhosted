# Copy to fastlane/.env (gitignored) and fill in. Fastlane auto-loads .env.
# chmod 600 .env
#
# Never commit .env. Never paste these values into chat / PR descriptions.
# After any accidental paste: rotate the GitHub PAT and consider rotating MATCH_PASSWORD.

APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
# Local: path to the raw AuthKey_*.p8 (preferred — keeps PEM out of .env body).
# Do not name this APP_STORE_CONNECT_API_KEY_PATH — Spaceship expects JSON there.
ASC_API_KEY_P8_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
# CI uses APP_STORE_CONNECT_API_KEY_CONTENT instead (Actions secret)

MATCH_PASSWORD=
MATCH_GIT_URL=https://github.com/yourorg/certs
# base64(github_username:PAT) — PAT needs access to the certs repo
GIT_BASIC_AUTH=

APP_BUNDLE_ID=com.yourcompany.yourapp
DEVELOPMENT_TEAM=
APPLE_ID=you@example.com
