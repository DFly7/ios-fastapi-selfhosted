default_platform(:ios)

platform :ios do
  # ── Shared setup ─────────────────────────────────────────────────────────

  before_all do
    # On CI (GitHub Actions) this sets up the keychain and reads MATCH_PASSWORD
    # from the environment automatically.
    setup_ci if ENV["CI"]

    # Configure the App Store Connect API key from env vars so every lane that
    # talks to App Store Connect (match, upload_to_testflight, etc.) uses
    # key-based auth instead of 2FA-blocked Apple ID password auth.
    # Local: ASC_API_KEY_P8_PATH → raw AuthKey_*.p8 (see fastlane/.env.example).
    # Do NOT use APP_STORE_CONNECT_API_KEY_PATH for a .p8 — Spaceship treats that
    # env var as a JSON key file and will JSON.parse the PEM.
    # CI: APP_STORE_CONNECT_API_KEY_CONTENT (secret string).
    if ENV["APP_STORE_CONNECT_API_KEY_ID"]
      key_args = {
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
        in_house: false
      }
      if ENV["ASC_API_KEY_P8_PATH"].to_s.strip != ""
        key_args[:key_filepath] = File.expand_path(ENV.fetch("ASC_API_KEY_P8_PATH"))
      else
        key_args[:key_content] = ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT")
        key_args[:is_key_content_base64] = false
      end
      app_store_connect_api_key(**key_args)
    end
  end

  # ── Lanes ─────────────────────────────────────────────────────────────────

  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      config_file: ".swiftlint.yml"
    )
  end

  # NOTE: There is intentionally no create_app / produce lane. fastlane produce
  # only supports Apple-ID (password + 2FA) auth, which can't run non-interactively
  # or in CI. The App Store Connect app record is a ONE-TIME manual creation in the
  # web UI (App Store Connect -> Apps -> +). After that, match (API key) manages the
  # bundle ID and signing, and upload_to_testflight pushes builds — no produce needed.

  desc "Register bundle ID + certs via match (API-key auth)"
  lane :provision do
    match(
      type: "appstore",
      readonly: ENV["CI"] ? true : false,
      force: ENV["MATCH_FORCE"] == "1"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Prerequisite: App Store Connect app record must already exist (one-time
    # web UI creation — see NOTE above). match handles signing.
    install_app_store_certs
    prepare_app_store_signing

    # TestFlight rejects duplicate build numbers for a marketing version.
    # Tuist sets CURRENT_PROJECT_VERSION in Project.swift, so pass a fresh one
    # at build time instead of agvtool (which isn't wired up for Tuist projects).
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    archive_and_export(build_number: build_number)

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Submit to the App Store (review not triggered automatically)"
  lane :release do
    # Prerequisite: App Store Connect app record must already exist (one-time
    # web UI creation — see NOTE above).
    install_app_store_certs
    prepare_app_store_signing

    build_number = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    archive_and_export(build_number: build_number)

    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  private_lane :install_app_store_certs do
    unless ENV["SKIP_MATCH"] == "1"
      match(
        type: "appstore",
        readonly: ENV["CI"] ? true : false
      )
    else
      UI.important("SKIP_MATCH=1 — using already-installed App Store certs/profile")
    end

    # Fail fast if the distribution identity did not land in the keychain.
    # match can print success while import failed (empty CI keychain).
    if ENV["CI"]
      keychain = "#{ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain")}-db"
      identities = sh(
        "security find-identity -v -p codesigning ~/Library/Keychains/#{keychain}",
        log: false
      )
      unless identities.include?("Apple Distribution")
        UI.user_error!(
          "No Apple Distribution identity in #{keychain} after match. " \
          "Check MATCH_PASSWORD / certs repo contents."
        )
      end
    end
  end

  # Project.swift defaults to Automatic (fine for local/dev). CI has no Apple ID
  # account, so flip only the StarterApp target to Manual + the match profile.
  # Do NOT pass PROVISIONING_PROFILE_SPECIFIER via xcargs — that bleeds onto
  # SPM targets (RevenueCat, …) which reject provisioning profiles.
  private_lane :prepare_app_store_signing do
    bundle_id = ENV.fetch("APP_BUNDLE_ID", "com.yourcompany.yourapp")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "StarterApp.xcodeproj",
      team_id: ENV.fetch("DEVELOPMENT_TEAM", "XXXXXXXXXX"),
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{bundle_id}",
      bundle_identifier: bundle_id,
      targets: ["StarterApp"]
    )
  end

  private_lane :archive_and_export do |options|
    bundle_id = ENV.fetch("APP_BUNDLE_ID", "com.yourcompany.yourapp")
    build_number = options[:build_number].to_s

    # Tuist writes Derived/InfoPlists/StarterApp-Info.plist; until regenerate picks up
    # $(CURRENT_PROJECT_VERSION), patch the literal so TestFlight accepts the upload.
    plist = "Derived/InfoPlists/StarterApp-Info.plist"
    if File.exist?(plist)
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: build_number)
    end

    build_app(
      workspace: "StarterApp.xcworkspace",
      scheme: "StarterApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}"
        }
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )
  end
end
